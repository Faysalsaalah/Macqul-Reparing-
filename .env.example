# Shared mode requires database setup and a linked Clerk identity.
APP_DATA_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_, paste it into chat, or commit it.
SUPABASE_SECRET_KEY=
# Exact browser origin; use HTTPS in production.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SERVER ONLY; pull with the official Clerk CLI.
CLERK_SECRET_KEY=

# Operator scripts require an explicit destination guard.
EXPECTED_SUPABASE_PROJECT_HOST=YOUR_PROJECT.supabase.co
